{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "willyfab-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "CORS_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://willyfab.com,https://www.willyfab.com",
    "ADMIN_TOKEN_TTL_MINUTES": "720",
    "MAX_UPLOAD_BYTES": "5242880",
    "R2_PUBLIC_BASE_URL": "https://media.willyfab.com"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "353f29b0113143f986015108630dc690"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "willyfab-media"
    }
  ]
}
