APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Administration. Generate the hash with: uv run python scripts/create_admin_password_hash.py
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
ADMIN_TOKEN_TTL_MINUTES=720

# Uploaded images. STORAGE_BACKEND=local writes to UPLOAD_DIR and serves from MEDIA_BASE_URL;
# STORAGE_BACKEND=r2 uses the R2_* settings below.
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MEDIA_BASE_URL=http://127.0.0.1:8000/media
MAX_UPLOAD_BYTES=5242880
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio

# Host port for the Docker Postgres container. Use 5433 if a local Postgres already uses 5432.
POSTGRES_PORT=5432
